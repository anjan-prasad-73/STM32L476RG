#include "uart.h"

// Note: Assumes SystemClock_HSI16() set SYSCLK = 16 MHz and APB1 prescaler = 1.
// Thus PCLK1 = 16 MHz. If your clock tree differs, adjust periphclk accordingly.

void usart2_init(uint32_t baud)
{
    // Enable GPIOA and USART2 clocks
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOAEN;
    RCC->APB1ENR1 |= RCC_APB1ENR1_USART2EN;

    // Configure PA2(TX) PA3(RX) : AF7
    GPIOA->MODER &= ~((3U << (2*2)) | (3U << (3*2)));
    GPIOA->MODER |=  ((2U << (2*2)) | (2U << (3*2)));
    GPIOA->AFR[0] &= ~((0xFU << (2*4)) | (0xFU << (3*4)));
    GPIOA->AFR[0] |=  ((7U << (2*4)) | (7U << (3*4)));

    // Optional: set speed and no-pull
    GPIOA->OSPEEDR |= (2U << (2*2)) | (2U << (3*2));
    GPIOA->PUPDR &= ~((3U << (2*2)) | (3U << (3*2)));

    // Disable USART before config
    USART2->CR1 &= ~USART_CR1_UE;

    // Calculate BRR: assume PCLK1 = 16 MHz
    uint32_t periphclk = 16000000U;
    // For oversampling by 16: USARTDIV = periphclk / baud
    uint32_t usartdiv = (periphclk + (baud/2)) / baud;
    USART2->BRR = usartdiv;

    // Configure: 8 data bits, no parity, 1 stop, enable TX and RX
    USART2->CR1 = USART_CR1_TE | USART_CR1_RE;
    USART2->CR2 = 0; // 1 stop bit
    USART2->CR3 = 0;

    // Enable USART
    USART2->CR1 |= USART_CR1_UE;

    // Wait until ready (TC/TE flags may take)
    (void)USART2->ISR;
}

void usart2_tx(const uint8_t *buf, int len)
{
    for (int i = 0; i < len; ++i) {
        // Wait for TXE
        while (!(USART2->ISR & USART_ISR_TXE));
        USART2->TDR = buf[i];
    }
    // Wait for TC (optional)
    while (!(USART2->ISR & USART_ISR_TC));
}

int usart2_rx(uint8_t *buf, int len, int timeout_ms)
{
    int rx = 0;
    // Convert timeout_ms to crude loop counter (approx); not precise but works for tests
    int loops_per_ms = 160; // rough for 16MHz, low optimization
    for (int i = 0; i < len; ++i) {
        int t = timeout_ms * loops_per_ms;
        while (!(USART2->ISR & USART_ISR_RXNE)) {
            if (--t <= 0) return rx;
        }
        buf[rx++] = USART2->RDR;
    }
    return rx;
}
