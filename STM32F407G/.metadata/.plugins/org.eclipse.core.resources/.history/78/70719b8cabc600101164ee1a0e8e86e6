 * Replace or merge into your CubeMX-generated project.
 * This file is written to be pasted into Core/Src/main.c (replace USER sections or whole file).
 * Requirements (CubeMX):
 *  - TIM2 configured as Input Capture on CH1 (PA0), prescaler so TIM ticks at 1 MHz (1us)
 *  - GPIO PA1 as TRIG output
 *  - UART2 (PA2 TX, PA3 RX) at 115200
 *  - Button on PC13 configured as External Interrupt
 *  - HAL drivers present
 *
 * FLASH area: uses Sector 11 (STM32F407 1MB device). Adjust FLASH_LOG_START_ADDR & SECTOR if different MCU.
 */

#include "main.h"
#include <string.h>
#include <stdio.h>
#include <stdarg.h>

/* ----- User changeable defines ----- */
#define TRIG_GPIO_PORT GPIOA
#define TRIG_PIN       GPIO_PIN_1

#define USER_BUTTON_PIN GPIO_PIN_13

/* FLASH logging area - STM32F407 (1MB): Sector 11 start address */
#define FLASH_LOG_START_ADDR  ((uint32_t)0x080E0000)
#define FLASH_SECTOR          FLASH_SECTOR_11

/* ----- External handles (from CubeMX) ----- */
extern UART_HandleTypeDef huart2;
extern TIM_HandleTypeDef htim2;

/* ----- Prototypes (prevent implicit declaration errors) ----- */
float measure_distance_cm(void);
uint32_t measure_pulse_width_us(void);
void trigger_ultrasonic(void);
int flash_append_line(const char *line);
int uart_printf(const char *fmt, ...);

/* ----- Globals ----- */
volatile uint32_t ic_rising = 0;
volatile uint32_t ic_falling = 0;
volatile uint8_t  ic_ready = 0; /* 0=no capture,1=rising,2=both */
static uint32_t flash_write_ptr = FLASH_LOG_START_ADDR;

/* ------------------------------------------------------------------ */
int uart_printf(const char *fmt, ...)
{
    char buf[200];
    va_list ap;
    va_start(ap, fmt);
    int len = vsnprintf(buf, sizeof(buf), fmt, ap);
    va_end(ap);
    if (len > 0) {
        HAL_UART_Transmit(&huart2, (uint8_t*)buf, len, HAL_MAX_DELAY);
    }
    return len;
}

/* TIM2 Input Capture callback: called from HAL_TIM_IRQHandler */
void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM2 && htim->Channel == HAL_TIM_ACTIVE_CHANNEL_1) {
        uint32_t val = HAL_TIM_ReadCapturedValue(&htim2, TIM_CHANNEL_1);
        if (ic_ready == 0) {
            ic_rising = val;
            ic_ready = 1;
        } else {
            ic_falling = val;
            ic_ready = 2;
        }
    }
}

/* EXTI callback for the user button */
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == USER_BUTTON_PIN) {
        float d = measure_distance_cm();
        char line[128];
        if (d < 0) snprintf(line, sizeof(line), "Distance: ERROR\r\n");
        else snprintf(line, sizeof(line), "Distance: %.2f cm\r\n", d);

        uart_printf("%s", line);
        if (flash_append_line(line) == 0) {
            uart_printf("Logged to Flash\r\n");
        } else {
            uart_printf("Flash log failed\r\n");
        }
    }
}

/* Generate trigger pulse (~10us) */
void trigger_ultrasonic(void)
{
    HAL_GPIO_WritePin(TRIG_GPIO_PORT, TRIG_PIN, GPIO_PIN_RESET);
    HAL_Delay(2);
    HAL_GPIO_WritePin(TRIG_GPIO_PORT, TRIG_PIN, GPIO_PIN_SET);
    /* short busy loop for ~10us (approx) */
    for (volatile int i = 0; i < 150; ++i) __NOP();
    HAL_GPIO_WritePin(TRIG_GPIO_PORT, TRIG_PIN, GPIO_PIN_RESET);
}

/* Measure pulse width in microseconds using TIM2 input-capture.
   Assumes TIM2 counter ticks at 1 MHz (1us per tick). */
uint32_t measure_pulse_width_us(void)
{
    ic_ready = 0;
    ic_rising = 0;
    ic_falling = 0;

    TIM_IC_InitTypeDef sConfigIC = {0};
    sConfigIC.ICPolarity = TIM_INPUTCHANNELPOLARITY_RISING;
    sConfigIC.ICSelection = TIM_ICSELECTION_DIRECTTI;
    sConfigIC.ICPrescaler = TIM_ICPSC_DIV1;
    sConfigIC.ICFilter = 0;

    HAL_TIM_IC_ConfigChannel(&htim2, &sConfigIC, TIM_CHANNEL_1);
    __HAL_TIM_SET_COUNTER(&htim2, 0);
    HAL_TIM_IC_Start_IT(&htim2, TIM_CHANNEL_1);

    trigger_ultrasonic();

    uint32_t tstart = HAL_GetTick();
    while (ic_ready == 0) {
        if (HAL_GetTick() - tstart > 100) { /* timeout 100ms */
            HAL_TIM_IC_Stop_IT(&htim2, TIM_CHANNEL_1);
            return 0xFFFFFFFF;
        }
    }

    /* switch to falling edge capture */
    HAL_TIM_IC_Stop_IT(&htim2, TIM_CHANNEL_1);
    sConfigIC.ICPolarity = TIM_INPUTCHANNELPOLARITY_FALLING;
    HAL_TIM_IC_ConfigChannel(&htim2, &sConfigIC, TIM_CHANNEL_1);
    HAL_TIM_IC_Start_IT(&htim2, TIM_CHANNEL_1);

    tstart = HAL_GetTick();
    while (ic_ready != 2) {
        if (HAL_GetTick() - tstart > 100) {
            HAL_TIM_IC_Stop_IT(&htim2, TIM_CHANNEL_1);
            return 0xFFFFFFFF;
        }
    }

    HAL_TIM_IC_Stop_IT(&htim2, TIM_CHANNEL_1);

    uint32_t rising = ic_rising;
    uint32_t falling = ic_falling;
    uint32_t ticks;
    if (falling >= rising) ticks = falling - rising;
    else ticks = (0xFFFFFFFF - rising) + falling + 1;

    return ticks; /* in microseconds if timer = 1MHz */
}

float measure_distance_cm(void)
{
    uint32_t width = measure_pulse_width_us();
    if (width == 0xFFFFFFFF || width == 0) return -1.0f;
    /* speed of sound ~343 m/s => 0.0343 cm/us; divide by 2 for round-trip */
    return (width * 0.0343f) / 2.0f;
}

/* FLASH append: very simple sequential appender. Erases sector on first use.
   WARNING: This is a basic example. Do NOT use in production without wear-leveling. */
int flash_append_line(const char *line)
{
    HAL_StatusTypeDef hres;
    uint32_t addr = flash_write_ptr;
    uint32_t len = strlen(line);
    uint32_t words = (len + 3) / 4;

    /* Erase once when pointer is at start */
    if (flash_write_ptr == FLASH_LOG_START_ADDR) {
        FLASH_EraseInitTypeDef EraseInit;
        uint32_t PageError = 0;

        EraseInit.TypeErase = FLASH_TYPEERASE_SECTORS;
        EraseInit.Sector = FLASH_SECTOR;
        EraseInit.NbSectors = 1;
        EraseInit.VoltageRange = FLASH_VOLTAGE_RANGE_3; /* 2.7-3.6V */

        hres = HAL_FLASH_Unlock();
        if (hres != HAL_OK) return -1;

        if (HAL_FLASHEx_Erase(&EraseInit, &PageError) != HAL_OK) {
            HAL_FLASH_Lock();
            return -1;
        }
        HAL_FLASH_Lock();
    }

    /* Program word-by-word (32-bit) */
    if (HAL_FLASH_Unlock() != HAL_OK) return -1;

    const uint8_t *p = (const uint8_t*)line;
    for (uint32_t i = 0; i < words; ++i) {
        uint32_t w = 0xFFFFFFFF;
        for (uint32_t b = 0; b < 4; ++b) {
            uint32_t idx = i*4 + b;
            uint8_t v = (idx < len) ? p[idx] : 0xFF;
            ((uint8_t*)&w)[b] = v;
        }
        if (HAL_FLASH_Program(FLASH_TYPEPROGRAM_WORD, addr, w) != HAL_OK) {
            HAL_FLASH_Lock();
            return -1;
        }
        addr += 4;
    }

    HAL_FLASH_Lock();
    flash_write_ptr = addr;
    return 0;
}

