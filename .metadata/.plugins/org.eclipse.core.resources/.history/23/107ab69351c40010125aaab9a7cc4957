#include "i2c_irq.h"

volatile uint8_t i2c_rx_buffer[32];
volatile uint8_t i2c_rx_index = 0;
volatile uint8_t i2c_transfer_done = 0;

void i2c1_irq_init(void)
{
    // Enable GPIOB and I2C1 clocks
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOBEN;
    RCC->APB1ENR1 |= RCC_APB1ENR1_I2C1EN;

    // PB8 (SCL) & PB9 (SDA) → AF4
    GPIOB->MODER &= ~((3U<<(8*2)) | (3U<<(9*2)));
    GPIOB->MODER |=  ((2U<<(8*2)) | (2U<<(9*2)));

    GPIOB->AFR[1] &= ~((0xF<<0) | (0xF<<4));
    GPIOB->AFR[1] |=  ((4U<<0) | (4U<<4));

    // Pull-ups
    GPIOB->PUPDR &= ~((3U<<(8*2)) | (3U<<(9*2)));
    GPIOB->PUPDR |=  ((1U<<(8*2)) | (1U<<(9*2)));

    // Open drain
    GPIOB->OTYPER |= (1<<8) | (1<<9);

    // Disable I2C
    I2C1->CR1 &= ~I2C_CR1_PE;

    // 16 MHz → Fast Mode 400 kHz
    I2C1->TIMINGR = 0x00300F38;

    // Enable interrupts
    I2C1->CR1 |= I2C_CR1_RXIE;   // RX interrupt
    I2C1->CR1 |= I2C_CR1_TXIE;   // TX interrupt
    I2C1->CR1 |= I2C_CR1_NACKIE; // NACK interrupt
    I2C1->CR1 |= I2C_CR1_STOPIE; // STOP interrupt

    // Enable peripheral
    I2C1->CR1 |= I2C_CR1_PE;

    // NVIC enable
    NVIC_SetPriority(I2C1_IRQn, 2);
    NVIC_EnableIRQ(I2C1_IRQn);
}

void i2c1_irq_start(uint8_t addr, uint8_t dir)
{
    i2c_transfer_done = 0;
    i2c_rx_index = 0;

    uint32_t tmp = 0;
    tmp |= (addr << 1);
    tmp |= (dir << 10);
    tmp |= (1U << 16);      // NBYTES = 1 for now

    I2C1->CR2 = tmp;

    I2C1->CR2 |= I2C_CR2_START; // generate START
}

void i2c1_irq_write(uint8_t data)
{
    I2C1->TXDR = data;
}

void i2c1_irq_read(uint8_t bytes)
{
    i2c_rx_index = 0;
    I2C1->CR2 &= ~(0xFF << 16);
    I2C1->CR2 |= (bytes << 16);
    I2C1->CR2 |= I2C_CR2_START;
}

void I2C1_IRQHandler(void)
{
    uint32_t isr = I2C1->ISR;

    // RX interrupt
    if (isr & I2C_ISR_RXNE)
    {
        uint8_t val = I2C1->RXDR;
        i2c_rx_buffer[i2c_rx_index++] = val;
    }

    // TX interrupt
    if (isr & I2C_ISR_TXIS)
    {
        // TXIS means ready to send next byte if needed
        // (unused here but available for multi-byte)
    }

    // NACK interrupt
    if (isr & I2C_ISR_NACKF)
    {
        I2C1->ICR |= I2C_ICR_NACKCF;
        I2C1->CR2 |= I2C_CR2_STOP;  // send STOP
    }

    // STOP interrupt
    if (isr & I2C_ISR_STOPF)
    {
        I2C1->ICR |= I2C_ICR_STOPCF;
        i2c_transfer_done = 1;
    }
}
