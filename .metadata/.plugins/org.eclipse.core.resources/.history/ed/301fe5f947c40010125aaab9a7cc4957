/*
 main_spi_polling.c
 Test program for 20_SPI_Driver (STM32L476RG)
 Bare-metal SPI1 master test (no HAL)

 Requires:
   - system_clock.c (SystemClock_HSI16)
   - spi_master.c / spi_master.h
   - gpio_driver.c / gpio_driver.h

 Behavior:
   - Initializes SPI1 in master mode (PA5= SCK, PA6= MISO, PA7= MOSI)
   - Continuously sends 0x55 over SPI
   - Reads back response byte
   - Toggles LED (PA5) each transfer
*/

#include "stm32l476xx.h"
#include "gpio_driver.h"
#include "spi_master.h"

// If no header for system clock:
void SystemClock_HSI16(void);

int main(void)
{
    /* 1) Set system clock = HSI16 */
    SystemClock_HSI16();

    /* 2) Enable GPIO port A for LED */
    gpio_enable_port_clock(GPIOA);
    gpio_config_pin(GPIOA, 5, GPIO_MODE_OUTPUT, GPIO_PULL_NONE); // LED PA5

    /* 3) Initialize SPI1 master */
    spi1_master_init();

    uint8_t rx;

    while (1)
    {
        /* Send a test byte over SPI */
        rx = spi1_transfer(0x55);

        /* Toggle LED to show activity */
        gpio_toggle_pin(GPIOA, 5);

        /* Small delay */
        for (volatile int d = 0; d < 200000; d++);
    }

    return 0;
}
