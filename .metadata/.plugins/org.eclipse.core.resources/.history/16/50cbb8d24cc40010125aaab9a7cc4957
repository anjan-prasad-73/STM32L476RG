#include "spi_master.h"

void spi1_master_init(void)
{
    // 1) Enable GPIOA and SPI1 clocks
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOAEN;
    RCC->APB2ENR |= RCC_APB2ENR_SPI1EN;

    // 2) Configure PA5 (SCK), PA6 (MISO), PA7 (MOSI) to AF5
    GPIOA->MODER &= ~((3U << (5*2)) | (3U << (6*2)) | (3U << (7*2)));
    GPIOA->MODER |=  ((2U << (5*2)) | (2U << (6*2)) | (2U << (7*2)));

    GPIOA->AFR[0] &= ~((0xF << 20) | (0xF << 24) | (0xF << 28));
    GPIOA->AFR[0] |=  ((5U << 20) | (5U << 24) | (5U << 28));

    // High speed for SPI pins (required)
    GPIOA->OSPEEDR |= (3U << (5*2)) | (3U << (6*2)) | (3U << (7*2));

    // 3) Disable SPI before configuration
    SPI1->CR1 &= ~SPI_CR1_SPE;

    // 4) Configure CR1
    SPI1->CR1 = SPI_CR1_MSTR      |   // Master mode
                SPI_CR1_SSM       |   // Software slave management
                SPI_CR1_SSI       |   // Internal slave select high
                (2U << 3);            // Baudrate = fPCLK/8

    // 5) Configure CR2: data size = 8-bit, FIFO threshold = 8-bit
    SPI1->CR2 = (7U << SPI_CR2_DS_Pos) | SPI_CR2_FRXTH;

    // 6) Enable SPI
    SPI1->CR1 |= SPI_CR1_SPE;
}

uint8_t spi1_transfer(uint8_t tx)
{
    while (!(SPI1->SR & SPI_SR_TXE));        // Wait TX empty

    *(__IO uint8_t *)&SPI1->DR = tx;         // Write 8-bit

    while (!(SPI1->SR & SPI_SR_RXNE));       // Wait RX full

    return *(__IO uint8_t *)&SPI1->DR;       // Read data
}
