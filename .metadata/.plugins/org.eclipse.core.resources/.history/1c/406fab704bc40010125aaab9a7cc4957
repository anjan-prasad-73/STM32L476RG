#include "spi_master.h"

void spi1_master_init(void)
{
    // Enable clocks
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOAEN;
    RCC->APB2ENR |= RCC_APB2ENR_SPI1EN;

    // PA5=SCK, PA6=MISO, PA7=MOSI -> AF5
    GPIOA->MODER &= ~((3U<<(5*2))|(3U<<(6*2))|(3U<<(7*2)));
    GPIOA->MODER |=  ((2U<<(5*2))|(2U<<(6*2))|(2U<<(7*2)));

    GPIOA->AFR[0] &= ~((0xF<<(5*4))|(0xF<<(6*4))|(0xF<<(7*4)));
    GPIOA->AFR[0] |=  ((5U<<(5*4))|(5U<<(6*4))|(5U<<(7*4)));

    // VERY IMPORTANT: High speed output for SPI pins
    GPIOA->OSPEEDR |= (3U<<(5*2)) | (3U<<(6*2)) | (3U<<(7*2));

    // Disable SPI before config
    SPI1->CR1 &= ~SPI_CR1_SPE;

    // Master mode, BR = PCLK/8, CPOL=0, CPHA=0
    SPI1->CR1 = SPI_CR1_MSTR | (2U<<3);

    // 8-bit frame format (DS=7), FIFO threshold = 8-bit
    SPI1->CR2 = (7U << SPI_CR2_DS_Pos) | SPI_CR2_FRXTH;

    // Internal NSS high
    SPI1->CR1 |= SPI_CR1_SSI;

    // Enable SPI peripheral
    SPI1->CR1 |= SPI_CR1_SPE;
}

uint8_t spi1_transfer(uint8_t tx)
{
    while(!(SPI1->SR & SPI_SR_TXE));
    *(__IO uint8_t *)&SPI1->DR = tx;

    while(!(SPI1->SR & SPI_SR_RXNE));
    return *(__IO uint8_t *)&SPI1->DR;
}
