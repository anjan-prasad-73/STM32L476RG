/*
 main_spi_irq.c
 SPI1 interrupt & loopback test (D11 <-> D12)
 - Requires: system_clock.c/h and spi_master.c/h present
 - Use PB3 as LED (no conflict with PA5)
*/

#include "stm32l476xx.h"
#include "system_clock.h"
#include "spi_master.h"
#include "spi_irq.h"

volatile uint8_t rx_byte; // optional: keep last received value for debug

int main(void)
{
    // 1) Switch to HSI16
    SystemClock_HSI16();

    // 2) Initialize SPI1 and enable IRQ (this also configures pins)
    spi1_irq_init();

    // 3) Simple loop: send a byte every ~100ms. IRQ will toggle PB3 on receive.
    while (1)
    {
        rx_byte = spi1_transfer(0x55); // loopback: D11->D12 must be wired
        for (volatile int i = 0; i < 200000; ++i) __asm__("nop");
    }

    // never reached
    return 0;
}
