#include "spi_master.h"

void spi1_master_init(void)
{
    // 1) Enable GPIOA clock and SPI1 clock
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOAEN;
    RCC->APB2ENR |= RCC_APB2ENR_SPI1EN;

    // 2) Configure PA5=SCK, PA6=MISO, PA7=MOSI -> AF5
    GPIOA->MODER &= ~((3U<<(5*2))|(3U<<(6*2))|(3U<<(7*2)));
    GPIOA->MODER |=  ((2U<<(5*2))|(2U<<(6*2))|(2U<<(7*2)));

    GPIOA->AFR[0] &= ~((0xF<<(5*4))|(0xF<<(6*4))|(0xF<<(7*4)));
    GPIOA->AFR[0] |=  ((5U<<(5*4))|(5U<<(6*4))|(5U<<(7*4)));

    // SPI requires HIGH SPEED GPIO
    GPIOA->OSPEEDR |= (3U<<(5*2)) | (3U<<(6*2)) | (3U<<(7*2));

    // 3) Disable SPI before configuration
    SPI1->CR1 &= ~SPI_CR1_SPE;

    // 4) Configure SPI1:
    // Master mode, CPOL=0, CPHA=0, BR=fPCLK/8, MSB first
    SPI1->CR1 = SPI_CR1_MSTR | (0x2 << 3);  // BR=010: fPCLK/8

    // 5) Configure CR2:
    // 8-bit data frame (DS=7), RXNE at 8-bit, no NSS output
    SPI1->CR2 = (7 << SPI_CR2_DS_Pos) | SPI_CR2_FRXTH;

    // 6) Set SSI=1 because we're not using hardware NSS
    SPI1->CR1 |= SPI_CR1_SSI;

    // 7) Enable SPI
    SPI1->CR1 |= SPI_CR1_SPE;
}

uint8_t spi1_transfer(uint8_t tx)
{
    // Wait until TX buffer empty
    while (!(SPI1->SR & SPI_SR_TXE));

    *(__IO uint8_t *)&SPI1->DR = tx;

    // Wait for received data
    while (!(SPI1->SR & SPI_SR_RXNE));

    return *(__IO uint8_t *)&SPI1->DR;
}
