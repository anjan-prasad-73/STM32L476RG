/* main.c - STM32F407 Discovery
 * Ultrasonic (HC-SR04) + Button -> measure & log into internal Flash + print via UART
 *
 * Pins (assumed):
 *  TRIG  -> PA1 (GPIO OUT)
 *  ECHO  -> PA0 (TIM2 CH1 - Input Capture)
 *  UART2 -> PA2(TX), PA3(RX)
 *  BUTTON-> PC13 (EXTI)
 *
 * TIM2 prescaler is set so the timer ticks at 1 MHz (1 us per tick).
 *
 * WARNING: Flash logging is a simple sequential appender. It erases Sector 11 on first use.
 * Change FLASH_LOG_START_ADDR / FLASH_SECTOR if you have a different memory map.
 */

#include "main.h"
#include <string.h>
#include <stdio.h>
#include <stdarg.h>

/* ---------------- User editable defines ---------------- */
#define TRIG_GPIO_PORT    GPIOA
#define TRIG_PIN          GPIO_PIN_1
#define USER_BUTTON_PIN   GPIO_PIN_13

/* Flash logging area — STM32F407 (1MB) Sector 11 */
#define FLASH_LOG_START_ADDR  ((uint32_t)0x080E0000)
#define FLASH_SECTOR          FLASH_SECTOR_11

/* ---------------- Forward prototypes (prevent implicit decls) ---------------- */
static void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART2_UART_Init(void);
static void MX_TIM2_Init(void);

float measure_distance_cm(void);
uint32_t measure_pulse_width_us(void);
void trigger_ultrasonic(void);
int flash_append_line(const char *line);
int uart_printf(const char *fmt, ...);

/* ---------------- Globals ---------------- */
/* Timer/IC capture globals */
volatile uint32_t ic_rising = 0;
volatile uint32_t ic_falling = 0;
volatile uint8_t  ic_ready = 0; /* 0=no capture,1=rising,2=both captured */

static uint32_t flash_write_ptr = FLASH_LOG_START_ADDR;

/* Note: huart2 and htim2 should be declared in main.h (CubeMX normally does this) */
 UART_HandleTypeDef huart2; TIM_HandleTypeDef htim2;

/* ---------------- UART printf helper ---------------- */
int uart_printf(const char *fmt, ...)
{
    char buf[200];
    va_list ap;
    va_start(ap, fmt);
    int len = vsnprintf(buf, sizeof(buf), fmt, ap);
    va_end(ap);
    if (len > 0) {
        HAL_UART_Transmit(&huart2, (uint8_t*)buf, (uint16_t)len, HAL_MAX_DELAY);
    }
    return len;
}

/* ---------------- TIM input-capture callback ----------------
   Called by HAL TIM IRQ handler when capture event occurs.
*/
void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM2 && HAL_TIM_ACTIVE_CHANNEL_1 == htim->Channel) {
        /* Note: depending on HAL version, check channel differently.
           We'll read value irrespective */
    }

    if (htim->Instance == TIM2) {
        uint32_t val = HAL_TIM_ReadCapturedValue(&htim2, TIM_CHANNEL_1);
        if (ic_ready == 0) {
            ic_rising = val;
            ic_ready = 1;
        } else {
            ic_falling = val;
            ic_ready = 2;
        }
    }
}

/* ---------------- Button EXTI callback ---------------- */
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == USER_BUTTON_PIN) {
        float d = measure_distance_cm();
        char line[128];
        if (d < 0) snprintf(line, sizeof(line), "Distance: ERROR\r\n");
        else snprintf(line, sizeof(line), "Distance: %.2f cm\r\n", d);

        uart_printf("%s", line);
        if (flash_append_line(line) == 0) {
            uart_printf("Logged to Flash\r\n");
        } else {
            uart_printf("Flash log failed\r\n");
        }
    }
}

/* ---------------- Trigger pulse (~10us) ---------------- */
void trigger_ultrasonic(void)
{
    HAL_GPIO_WritePin(TRIG_GPIO_PORT, TRIG_PIN, GPIO_PIN_RESET);
    HAL_Delay(2);
    HAL_GPIO_WritePin(TRIG_GPIO_PORT, TRIG_PIN, GPIO_PIN_SET);
    /* short busy loop for ~10us (approx) */
    for (volatile int i = 0; i < 150; ++i) __NOP();
    HAL_GPIO_WritePin(TRIG_GPIO_PORT, TRIG_PIN, GPIO_PIN_RESET);
}

/* ---------------- Measure pulse width (us) using TIM2 IC ----------------
   Assumes TIM2 counts at 1 MHz (1us ticks).
*/
uint32_t measure_pulse_width_us(void)
{
    ic_ready = 0;
    ic_rising = 0;
    ic_falling = 0;

    TIM_IC_InitTypeDef sConfigIC = {0};
    sConfigIC.ICPolarity = TIM_INPUTCHANNELPOLARITY_RISING;
    sConfigIC.ICSelection = TIM_ICSELECTION_DIRECTTI;
    sConfigIC.ICPrescaler = TIM_ICPSC_DIV1;
    sConfigIC.ICFilter = 0;

    HAL_TIM_IC_ConfigChannel(&htim2, &sConfigIC, TIM_CHANNEL_1);
    __HAL_TIM_SET_COUNTER(&htim2, 0);
    HAL_TIM_IC_Start_IT(&htim2, TIM_CHANNEL_1);

    trigger_ultrasonic();

    uint32_t tstart = HAL_GetTick();
    while (ic_ready == 0) {
        if ((HAL_GetTick() - tstart) > 100) { /* 100 ms timeout */
            HAL_TIM_IC_Stop_IT(&htim2, TIM_CHANNEL_1);
            return 0xFFFFFFFF;
        }
    }

    /* switch to falling edge */
    HAL_TIM_IC_Stop_IT(&htim2, TIM_CHANNEL_1);
    sConfigIC.ICPolarity = TIM_INPUTCHANNELPOLARITY_FALLING;
    HAL_TIM_IC_ConfigChannel(&htim2, &sConfigIC, TIM_CHANNEL_1);
    HAL_TIM_IC_Start_IT(&htim2, TIM_CHANNEL_1);

    tstart = HAL_GetTick();
    while (ic_ready != 2) {
        if ((HAL_GetTick() - tstart) > 100) {
            HAL_TIM_IC_Stop_IT(&htim2, TIM_CHANNEL_1);
            return 0xFFFFFFFF;
        }
    }

    HAL_TIM_IC_Stop_IT(&htim2, TIM_CHANNEL_1);

    uint32_t rising = ic_rising;
    uint32_t falling = ic_falling;
    uint32_t ticks;
    if (falling >= rising) ticks = falling - rising;
    else ticks = (0xFFFFFFFF - rising) + falling + 1;

    return ticks; /* microseconds if timer running at 1 MHz */
}

/* ---------------- Measure distance in cm ---------------- */
float measure_distance_cm(void)
{
    uint32_t us = measure_pulse_width_us();
    if (us == 0xFFFFFFFF || us == 0) return -1.0f;
    /* speed of sound ~343 m/s => 0.0343 cm/us; divide by 2 for roundtrip */
    return (us * 0.0343f) / 2.0f;
}

/* ---------------- Flash append (simple sequential logger) ----------------
   - Erases FLASH_SECTOR on first write (flash_write_ptr == start)
   - Programs 32-bit words; pads leftover bytes with 0xFF
   - NOT production-grade; no wear-leveling or bounds checks
*/
int flash_append_line(const char *line)
{
    HAL_StatusTypeDef hres;
    uint32_t addr = flash_write_ptr;
    uint32_t len = strlen(line);
    uint32_t words = (len + 3) / 4;

    /* Erase sector once */
    if (flash_write_ptr == FLASH_LOG_START_ADDR) {
        FLASH_EraseInitTypeDef EraseInit = {0};
        uint32_t PageError = 0;

        EraseInit.TypeErase = FLASH_TYPEERASE_SECTORS;
        EraseInit.Sector = FLASH_SECTOR;
        EraseInit.NbSectors = 1;
        EraseInit.VoltageRange = FLASH_VOLTAGE_RANGE_3;

        if (HAL_FLASH_Unlock() != HAL_OK) return -1;
        if (HAL_FLASHEx_Erase(&EraseInit, &PageError) != HAL_OK) {
            HAL_FLASH_Lock();
            return -1;
        }
        HAL_FLASH_Lock();
    }

    /* Program word-by-word */
    if (HAL_FLASH_Unlock() != HAL_OK) return -1;

    const uint8_t *p = (const uint8_t*)line;
    for (uint32_t i = 0; i < words; ++i) {
        uint32_t w = 0xFFFFFFFF;
        for (uint32_t b = 0; b < 4; ++b) {
            uint32_t idx = i*4 + b;
            uint8_t v = (idx < len) ? p[idx] : 0xFF;
            ((uint8_t*)&w)[b] = v;
        }
        if (HAL_FLASH_Program(FLASH_TYPEPROGRAM_WORD, addr, w) != HAL_OK) {
            HAL_FLASH_Lock();
            return -1;
        }
        addr += 4;
    }

    HAL_FLASH_Lock();
    flash_write_ptr = addr;
    return 0;
}

/* ---------------- Main ---------------- */
int main(void)
{
    HAL_Init();

    SystemClock_Config();
    MX_GPIO_Init();
    MX_USART2_UART_Init();
    MX_TIM2_Init();

    uart_printf("STM32F407 Discovery - Ultrasonic Flash Logger\r\n");
    uart_printf("Press the user button to measure and log.\r\n");

    while (1) {
        HAL_Delay(1000);
    }
}

/* ---------------- System & peripheral init functions ---------------- */

/* System Clock config - HSE 8MHz -> PLL -> SYSCLK 168MHz (typical for F407) */
static void SystemClock_Config(void)
{
    RCC_OscInitTypeDef RCC_OscInitStruct = {0};
    RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

    __HAL_RCC_PWR_CLK_ENABLE();
    __HAL_PWR_VOLTAGESCALING_CONFIG(PWR_REGULATOR_VOLTAGE_SCALE1);

    RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSE;
    RCC_OscInitStruct.HSEState = RCC_HSE_ON;
    RCC_OscInitStruct.PLL.PLLState = RCC_PLL_ON;
    RCC_OscInitStruct.PLL.PLLSource = RCC_PLLSOURCE_HSE;
    RCC_OscInitStruct.PLL.PLLM = 8;
    RCC_OscInitStruct.PLL.PLLN = 336;
    RCC_OscInitStruct.PLL.PLLP = RCC_PLLP_DIV2;
    RCC_OscInitStruct.PLL.PLLQ = 7;
    if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK) { Error_Handler(); }

    RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK | RCC_CLOCKTYPE_SYSCLK |
                                  RCC_CLOCKTYPE_PCLK1 | RCC_CLOCKTYPE_PCLK2;
    RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
    RCC_ClkInitStruct.AHBCLKDivider = RCC_SYSCLK_DIV1;
    RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV4;  /* 42 MHz */
    RCC_ClkInitStruct.APB2CLKDivider = RCC_HCLK_DIV2;  /* 84 MHz */

    if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_5) != HAL_OK) { Error_Handler(); }
}

/* GPIO init: TRIG PA1 output, BUTTON PC13 EXTI */
static void MX_GPIO_Init(void)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};

    /* Enable GPIO clocks */
    __HAL_RCC_GPIOA_CLK_ENABLE();
    __HAL_RCC_GPIOC_CLK_ENABLE();

    /* TRIG pin (PA1) */
    GPIO_InitStruct.Pin = TRIG_PIN;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(TRIG_GPIO_PORT, &GPIO_InitStruct);

    /* Button PC13 (EXTI falling edge) */
    GPIO_InitStruct.Pin = USER_BUTTON_PIN;
    GPIO_InitStruct.Mode = GPIO_MODE_IT_FALLING;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    HAL_GPIO_Init(GPIOC, &GPIO_InitStruct);

    HAL_NVIC_SetPriority(EXTI15_10_IRQn, 2, 0);
    HAL_NVIC_EnableIRQ(EXTI15_10_IRQn);
}

/* UART2 init (PA2=TX, PA3=RX) */
static void MX_USART2_UART_Init(void)
{
    huart2.Instance = USART2;
    huart2.Init.BaudRate = 115200;
    huart2.Init.WordLength = UART_WORDLENGTH_8B;
    huart2.Init.StopBits = UART_STOPBITS_1;
    huart2.Init.Parity = UART_PARITY_NONE;
    huart2.Init.Mode = UART_MODE_TX_RX;
    huart2.Init.HwFlowCtl = UART_HWCONTROL_NONE;
    huart2.Init.OverSampling = UART_OVERSAMPLING_16;
    if (HAL_UART_Init(&huart2) != HAL_OK) { Error_Handler(); }
}

/* TIM2 init for Input Capture on CH1 (PA0) with 1 MHz timer clock */
static void MX_TIM2_Init(void)
{
    TIM_IC_InitTypeDef sConfigIC = {0};
    TIM_MasterConfigTypeDef sMasterConfig = {0};

    __HAL_RCC_TIM2_CLK_ENABLE();

    htim2.Instance = TIM2;
    htim2.Init.Prescaler = 83; /* assuming APB1 timer clock = 84 MHz -> 1 MHz */
    htim2.Init.CounterMode = TIM_COUNTERMODE_UP;
    htim2.Init.Period = 0xFFFFFFFF;
    htim2.Init.ClockDivision = TIM_CLOCKDIVISION_DIV1;
    if (HAL_TIM_IC_Init(&htim2) != HAL_OK) { Error_Handler(); }

    sMasterConfig.MasterOutputTrigger = TIM_TRGO_RESET;
    sMasterConfig.MasterSlaveMode = TIM_MASTERSLAVEMODE_DISABLE;
    HAL_TIMEx_MasterConfigSynchronization(&htim2, &sMasterConfig);

    sConfigIC.ICPolarity = TIM_INPUTCHANNELPOLARITY_RISING;
    sConfigIC.ICSelection = TIM_ICSELECTION_DIRECTTI;
    sConfigIC.ICPrescaler = TIM_ICPSC_DIV1;
    sConfigIC.ICFilter = 0;
    HAL_TIM_IC_ConfigChannel(&htim2, &sConfigIC, TIM_CHANNEL_1);

    HAL_NVIC_SetPriority(TIM2_IRQn, 1, 0);
    HAL_NVIC_EnableIRQ(TIM2_IRQn);
}

