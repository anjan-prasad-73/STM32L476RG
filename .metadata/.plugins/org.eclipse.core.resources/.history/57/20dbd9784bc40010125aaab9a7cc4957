#include "stm32l476xx.h"
#include "spi_master.h"

void SystemClock_HSI16(void);

volatile uint32_t dbg_apb2 = 0;
volatile uint32_t dbg_moder = 0;
volatile uint32_t dbg_afrl = 0;
volatile uint32_t dbg_sr = 0;
volatile uint32_t dbg_cr1 = 0;

volatile uint8_t rx_byte = 0;

int main(void)
{
    SystemClock_HSI16();
    spi1_master_init();

    // DEBUG READBACK
    dbg_apb2 = RCC->APB2ENR;        // Must show SPI1EN = 1
    dbg_moder = GPIOA->MODER;       // PA5/PA6/PA7 must be AF(10)
    dbg_afrl = GPIOA->AFR[0];       // AF5 = 0101 on pins 5,6,7
    dbg_cr1 = SPI1->CR1;            // SPE must be 1, SSI=1, MSTR=1
    dbg_sr  = SPI1->SR;             // TXE should be 1

    while (1)
    {
        rx_byte = spi1_transfer(0x55);
        for (volatile int i = 0; i < 50000; i++);
    }
}
