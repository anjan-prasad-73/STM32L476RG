#include "main.h"
#include <string.h>
#include <stdio.h>
#include <stdarg.h>

/* ---------------- Pin Defines ---------------- */
#define TRIG_PORT   GPIOA
#define TRIG_PIN    GPIO_PIN_1
#define ECHO_PORT   GPIOA
#define ECHO_PIN    GPIO_PIN_0
#define USER_BUTTON_PIN GPIO_PIN_13

/* Flash logging area */
#define FLASH_LOG_START_ADDR  ((uint32_t)0x080E0000)
#define FLASH_SECTOR          FLASH_SECTOR_11

UART_HandleTypeDef huart2;

/* Flash pointer */
static uint32_t flash_write_ptr = FLASH_LOG_START_ADDR;

/* ------------ UART printf ------------ */
int uart_printf(const char *fmt, ...)
{
    char buf[200];
    va_list ap;
    va_start(ap, fmt);
    int len = vsnprintf(buf, sizeof(buf), fmt, ap);
    va_end(ap);

    HAL_UART_Transmit(&huart2, (uint8_t*)buf, len, HAL_MAX_DELAY);
    return len;
}

/* ------------ Trigger 10us pulse ------------ */
void trigger_pulse(void)
{
    HAL_GPIO_WritePin(TRIG_PORT, TRIG_PIN, GPIO_PIN_RESET);
    HAL_Delay(2);

    HAL_GPIO_WritePin(TRIG_PORT, TRIG_PIN, GPIO_PIN_SET);
    for (volatile int i = 0; i < 150; i++);   // ~10us
    HAL_GPIO_WritePin(TRIG_PORT, TRIG_PIN, GPIO_PIN_RESET);
}

/* ------------ Measure pulse width using GPIO ------------ */
/* No TIM2 - pure polling */
uint32_t measure_pulse_us(void)
{
    uint32_t timeout;

    trigger_pulse();

    /* Wait for HIGH */
    timeout = 30000;
    while (HAL_GPIO_ReadPin(ECHO_PORT, ECHO_PIN) == GPIO_PIN_RESET)
    {
        if (--timeout == 0) return 0xFFFFFFFF;
    }

    /* Count HIGH time */
    uint32_t count = 0;
    while (HAL_GPIO_ReadPin(ECHO_PORT, ECHO_PIN) == GPIO_PIN_SET)
    {
        count++;
        for (volatile int i = 0; i < 15; i++); // ~1us

        if (count > 30000) return 0xFFFFFFFF;
    }

    return count;  // microseconds (approx)
}

/* ------------ Convert pulse to distance ------------ */
float measure_distance_cm(void)
{
    uint32_t us = measure_pulse_us();
    if (us == 0xFFFFFFFF) return -1;

    return (us * 0.0343f) / 2.0f;
}

/* ------------ Flash append ------------ */
int flash_append_line(const char *line)
{
    uint32_t addr = flash_write_ptr;
    uint32_t len = strlen(line);
    uint32_t words = (len + 3) / 4;

    /* Erase first, only once */
    if (flash_write_ptr == FLASH_LOG_START_ADDR)
    {
        FLASH_EraseInitTypeDef EraseInit = {0};
        uint32_t PageError = 0;

        EraseInit.TypeErase = FLASH_TYPEERASE_SECTORS;
        EraseInit.Sector = FLASH_SECTOR;
        EraseInit.NbSectors = 1;
        EraseInit.VoltageRange = FLASH_VOLTAGE_RANGE_3;

        HAL_FLASH_Unlock();
        HAL_FLASHEx_Erase(&EraseInit, &PageError);
        HAL_FLASH_Lock();
    }

    HAL_FLASH_Unlock();

    const uint8_t *p = (uint8_t*)line;
    for (int i = 0; i < words; i++)
    {
        uint32_t w = 0xFFFFFFFF;
        for (int b = 0; b < 4; b++)
        {
            uint32_t idx = i*4 + b;
            if (idx < len)
                ((uint8_t*)&w)[b] = p[idx];
        }

        if (HAL_FLASH_Program(FLASH_TYPEPROGRAM_WORD, addr, w) != HAL_OK)
        {
            HAL_FLASH_Lock();
            return -1;
        }

        addr += 4;
    }

    HAL_FLASH_Lock();
    flash_write_ptr = addr;
    return 0;
}

/* ------------ EXTI Callback ------------ */
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == USER_BUTTON_PIN)
    {
        float d = measure_distance_cm();
        char log_line[64];

        if (d < 0) sprintf(log_line, "Distance: ERROR\r\n");
        else sprintf(log_line, "Distance: %.2f cm\r\n", d);

        uart_printf("%s", log_line);

        if (flash_append_line(log_line) == 0)
            uart_printf("Logged to Flash\r\n");
        else
            uart_printf("Flash Error!\r\n");
    }
}

/* ------------ Initializations ------------ */

void SystemClock_Config(void)
{
    RCC_OscInitTypeDef osc = {0};
    RCC_ClkInitTypeDef clk = {0};

    __HAL_RCC_PWR_CLK_ENABLE();
    __HAL_PWR_VOLTAGESCALING_CONFIG(PWR_REGULATOR_VOLTAGE_SCALE1);

    osc.OscillatorType = RCC_OSCILLATORTYPE_HSE;
    osc.HSEState = RCC_HSE_ON;
    osc.PLL.PLLState = RCC_PLL_ON;
    osc.PLL.PLLSource = RCC_PLLSOURCE_HSE;
    osc.PLL.PLLM = 8;
    osc.PLL.PLLN = 336;
    osc.PLL.PLLP = RCC_PLLP_DIV2;
    osc.PLL.PLLQ = 7;
    HAL_RCC_OscConfig(&osc);

    clk.ClockType = RCC_CLOCKTYPE_HCLK | RCC_CLOCKTYPE_SYSCLK |
                    RCC_CLOCKTYPE_PCLK1 | RCC_CLOCKTYPE_PCLK2;
    clk.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
    clk.AHBCLKDivider = RCC_SYSCLK_DIV1;
    clk.APB1CLKDivider = RCC_HCLK_DIV4;
    clk.APB2CLKDivider = RCC_HCLK_DIV2;
    HAL_RCC_ClockConfig(&clk, FLASH_LATENCY_5);
}

void MX_GPIO_Init(void)
{
    GPIO_InitTypeDef gpio = {0};

    __HAL_RCC_GPIOA_CLK_ENABLE();
    __HAL_RCC_GPIOC_CLK_ENABLE();

    /* TRIG (PA1) */
    gpio.Pin = TRIG_PIN;
    gpio.Mode = GPIO_MODE_OUTPUT_PP;
    gpio.Pull = GPIO_NOPULL;
    HAL_GPIO_Init(TRIG_PORT, &gpio);

    /* ECHO (PA0) */
    gpio.Pin = ECHO_PIN;
    gpio.Mode = GPIO_MODE_INPUT;
    gpio.Pull = GPIO_NOPULL;
    HAL_GPIO_Init(ECHO_PORT, &gpio);

    /* Button PC13 */
    gpio.Pin = USER_BUTTON_PIN;
    gpio.Mode = GPIO_MODE_IT_FALLING;
    gpio.Pull = GPIO_NOPULL;
    HAL_GPIO_Init(GPIOC, &gpio);

    HAL_NVIC_SetPriority(EXTI15_10_IRQn, 2, 0);
    HAL_NVIC_EnableIRQ(EXTI15_10_IRQn);
}

void MX_USART2_UART_Init(void)
{
    __HAL_RCC_USART2_CLK_ENABLE();

    huart2.Instance = USART2;
    huart2.Init.BaudRate = 115200;
    huart2.Init.WordLength = UART_WORDLENGTH_8B;
    huart2.Init.StopBits = UART_STOPBITS_1;
    huart2.Init.Parity = UART_PARITY_NONE;
    huart2.Init.Mode = UART_MODE_TX_RX;
    huart2.Init.HwFlowCtl = UART_HWCONTROL_NONE;
    HAL_UART_Init(&huart2);
}

/* ------------ MAIN ------------ */
int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_USART2_UART_Init();

    uart_printf("HC-SR04 Ultrasonic Logger (GPIO Mode)\r\n");
    uart_printf("Press Button to Measure\r\n");

    while (1)
    {
        HAL_Delay(500);
    }
}
