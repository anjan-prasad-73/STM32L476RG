#include "stm32l476xx.h"
#include <string.h>

#define SYSCLK_HZ 16000000U
const char msg[] = "Hello DMA UART from L476 using CSELR!\r\n";

/* -------------------- CLOCK: HSI ENABLE -------------------- */
void Clock_HSI_Enable(void)
{
    RCC->CR |= RCC_CR_HSION;
    while(!(RCC->CR & RCC_CR_HSIRDY));

    RCC->CFGR &= ~RCC_CFGR_SW;
    RCC->CFGR |=  RCC_CFGR_SW_HSI;

    while((RCC->CFGR & RCC_CFGR_SWS) != RCC_CFGR_SWS_HSI);
}

/* -------------------- USART2 GPIO -------------------- */
void uart2_gpio_init(void)
{
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOAEN;

    GPIOA->MODER &= ~((3<<4)|(3<<6));
    GPIOA->MODER |=  (2<<4)|(2<<6);   // AF mode

    GPIOA->AFR[0] &= ~((0xF<<8)|(0xF<<12));
    GPIOA->AFR[0] |=  (7<<8)|(7<<12); // AF7 = USART2
}

/* -------------------- USART2 -------------------- */
void uart2_init(void)
{
    RCC->APB1ENR1 |= RCC_APB1ENR1_USART2EN;

    USART2->CR1 = 0;
    USART2->BRR = SYSCLK_HZ / 115200;
    USART2->CR1 |= USART_CR1_TE;
    USART2->CR1 |= USART_CR1_UE;

    while(!(USART2->ISR & USART_ISR_TEACK));
}

/* -------------------- DMA1 Channel 7 CSELR mapping -------------------- */
void dma_cselr_map_usart2_tx(void)
{
    /* Enable DMA1 clock */
    RCC->AHB1ENR |= RCC_AHB1ENR_DMA1EN;

    /* Set C7S = 4 (USART2_TX) */
    /* Each channel uses 4 bits in CSELR register */
    DMA1_CSELR->CSELR &= ~(0xF << (7 * 4));  // clear channel7 bits
    DMA1_CSELR->CSELR |=  (4   << (7 * 4));  // map CH7 -> request 4
}

/* -------------------- DMA1 Channel 7 TX -------------------- */
void dma_usart2_tx_start(void)
{
    DMA1_Channel7->CCR &= ~DMA_CCR_EN;
    while(DMA1_Channel7->CCR & DMA_CCR_EN);

    DMA1_Channel7->CPAR  = (uint32_t)&USART2->TDR;
    DMA1_Channel7->CMAR  = (uint32_t)msg;
    DMA1_Channel7->CNDTR = strlen(msg);

    DMA1_Channel7->CCR = DMA_CCR_MINC | DMA_CCR_DIR | (1<<12);

    USART2->CR3 |= USART_CR3_DMAT;

    DMA1_Channel7->CCR |= DMA_CCR_EN;
}

/* -------------------- UART Polling Print -------------------- */
void uart2_putc(char c)
{
    while(!(USART2->ISR & USART_ISR_TXE));
    USART2->TDR = c;
}

void uart2_print(const char *s)
{
    while(*s) uart2_putc(*s++);
}

/* -------------------- MAIN -------------------- */
int main(void)
{
    Clock_HSI_Enable();
    uart2_gpio_init();
    uart2_init();

    uart2_print("UART polling OK\r\n");

    dma_cselr_map_usart2_tx();  // <<< IMPORTANT FIX
    dma_usart2_tx_start();

    uart2_print("DMA started, waiting...\r\n");

    while(DMA1_Channel7->CNDTR != 0);

    while(!(USART2->ISR & USART_ISR_TC));
    USART2->ICR = USART_ICR_TCCF;

    uart2_print("DMA done!\r\n");

    while(1);
}
