void TIM2_IRQHandler(void)
{
    HAL_TIM_IRQHandler(&htim2);
}

void EXTI15_10_IRQHandler(void)
{
    HAL_GPIO_EXTI_IRQHandler(USER_BUTTON_PIN);
}

